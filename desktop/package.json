{
  "name": "anime-character-desktop",
  "version": "0.2.2",
  "private": true,
  "description": "Anime Character Archive Windows desktop companion",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.cjs && node --check preload.cjs && node --check main.test.cjs && node --check ../assets/js/spine/spine-runtime.js && node --check ../assets/js/spine/desktop-drag.js",
    "dist": "electron-builder --win nsis portable",
    "test": "node --test main.test.cjs"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "dev.animecharacterarchive.desktop",
    "productName": "次元桌面立绘",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "protocols": [
      {
        "name": "Anime Character Desktop",
        "schemes": [
          "animecharacter"
        ]
      }
    ]
  }
}
